PORT=3000
NODE_ENV=development
SERVICE_NAME=facilpay-api
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
REFRESH_TOKEN_EXPIRY_DAYS=30
TWO_FACTOR_ENCRYPTION_KEY=change-this-long-random-secret-for-2fa-encryption

# Account lockout configuration
# Number of failed login attempts before an account is locked (default: 5)
LOGIN_MAX_ATTEMPTS=5
# Minutes a locked account stays locked before it automatically unlocks (default: 15)
LOGIN_LOCK_DURATION_MINUTES=15

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=facilpay
DATABASE_SYNCHRONIZE=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
DATABASE_SLOW_QUERY_THRESHOLD_MS=500

# Logging
LOG_LEVEL=debug
LOG_DIR=logs
LOG_PRETTY=true
LOG_MAX_SIZE=10m
LOG_RETENTION_DAYS=14
LOG_BODY=false
LOG_BODY_MAX_LENGTH=2048
LOG_RESPONSE_BODY=false

# Stellar Configuration
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_BASE_FEE=100
STELLAR_MAX_FEE=1000
# Horizon fee_stats percentile (p10, p20, ..., p70, p80, p90, p95, p99)
STELLAR_FEE_PERCENTILE=p70
# Days until the platform may reclaim an unclaimed issued-asset balance
STELLAR_CLAIMABLE_RECLAIM_DAYS=90
# Comma-separated assetCode:minimum balance thresholds; checked every 10 minutes
STELLAR_LOW_BALANCE_THRESHOLDS=XLM:100,USDC:1000
# Optional comma-separated operator email recipients and alert webhook
STELLAR_OPS_EMAILS=
STELLAR_LOW_BALANCE_WEBHOOK_URL=
# The secret key for the platform's distribution account
STELLAR_SOURCE_SECRET=SA...YOUR_SECRET_KEY
# Default per-merchant daily limit for outbound payouts
PAYOUT_DAILY_LIMIT=10000
# Email / SMTP Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM='"FacilPay" <noreply@facilpay.com>'
# Email delivery webhooks (bounces / complaints)
EMAIL_WEBHOOK_SECRET=change-me-email-webhook-secret
SENDGRID_WEBHOOK_PUBLIC_KEY=
APP_URL=http://localhost:3000

# CORS Configuration
# Comma-separated list of allowed origins (leave empty to disable CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.facilpay.com
# Set to "true" to allow credentials (cookies, auth headers) — opt-in only
CORS_ALLOW_CREDENTIALS=false

# Trusted reverse proxies
# Comma-separated IP addresses or CIDR blocks of reverse proxies that are
# allowed to set X-Forwarded-For (e.g. 10.0.0.0/8,192.168.1.10). Leave empty
# when the app is exposed directly: X-Forwarded-For is then never trusted and
# the socket peer address is used for IP allowlist / geo-restriction checks.
TRUSTED_PROXY_IPS=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Idempotency Configuration
# Time-to-live for idempotency keys in hours (default: 24)
IDEMPOTENCY_TTL_HOURS=24

# Google Sign-In (OIDC with PKCE) — all required to enable POST /v1/auth/google/*.
# Set GOOGLE_CLIENT_ID/SECRET from Google Cloud Console (OAuth client, web application).
# GOOGLE_REDIRECT_URI must be allow-listed in the Google client and returned by the
# authorize step (clients may override per-request but must match on callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.facilpay.com/auth/google/callback
# OIDC issuer (defaults to https://accounts.google.com when empty)
GOOGLE_OIDC_ISSUER=https://accounts.google.com

# SEP-10 Stellar web authentication (GET/POST /v1/auth/sep10/*).
# SEP10_SIGNING_SECRET defaults to STELLAR_SOURCE_SECRET when empty.
SEP10_SIGNING_SECRET=
# Home domain asserted in SEP-10 challenge manageData operations (defaults to facilpay.com)
SEP10_HOME_DOMAIN=facilpay.com
STELLAR_HOME_DOMAIN=facilpay.com
# Challenge lifetime in seconds (default 900 = 15 minutes, replay-protected via single-use nonce)
SEP10_CHALLENGE_TIMEOUT_SECONDS=900

# Webhook signature secret used for HMAC verification
WEBHOOK_SECRET=change-this-webhook-secret

# Payment currencies accepted by validation and currency endpoints
SUPPORTED_CURRENCIES=USD,EUR,GBP

# Default number of seconds before a PENDING payment expires (default: 1800 = 30 minutes)
PAYMENT_DEFAULT_EXPIRY_SECONDS=1800

# Maximum number of refunds allowed per payment (default: 20)
PAYMENT_MAX_REFUNDS_PER_PAYMENT=20

# FX rate provider (used to populate GET /v1/rates)
FX_PROVIDER_URL=https://api.exchangerate.host/latest
# TTL in seconds for cached FX rates in Redis (default: 60)
FX_RATE_CACHE_TTL_SECONDS=60

# TTL in seconds for cached IP-to-country geolocation lookups (default: 300)
GEO_LOOKUP_CACHE_TTL_SECONDS=300

# Stable secret shared by API and webhook workers for AES-GCM custom header encryption.
# Required when custom webhook headers are configured.
WEBHOOK_HEADERS_ENCRYPTION_KEY=
